{
  "name": "app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^54.0.36",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "bundle:play": "test -f .env || { echo '⚠️ App/.env が要る（署名鍵の設定）。SETUP.md「Playストアに出すビルド」参照'; exit 1; } && TRG_ALL_ABI=1 expo prebuild --platform android --clean && set -a && . ./.env && set +a && TRG_ALL_ABI=1 ./android/gradlew -p android bundleRelease",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "gen:api": "openapi-typescript ../docs/02_api_openapi.yaml -o src/api/schema.ts",
    "postinstall": "npm run gen:api",
    "prestart": "npm run gen:api",
    "typecheck": "npm run gen:api && tsc --noEmit"
  },
  "private": true
}
